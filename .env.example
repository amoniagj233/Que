# =====================================================================
# APEX AI / HEADWAY MT5 TRADING STATION — ENVIRONMENT CONFIGURATION
# =====================================================================
# Note: By default, the system automatically auto-discovers MetaTrader 5
# and connects seamlessly. Only set these if you want to override defaults.

# Optional: Path to terminal64.exe (leave blank for automatic auto-discovery)
# MT5_PATH=C:\Program Files\Headway MT5 Terminal\terminal64.exe
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Optional: Broker login credentials for automatic authentication
# MT5_LOGIN=6278930
# MT5_PASSWORD=YourPasswordHere
# MT5_SERVER=Headway-Real

# Port for Web Dashboard & Supreme Commander Workstation (Default: 8765)
PORT=8765
BRIDGE_HOST=0.0.0.0

# Gold Symbol override if your broker uses a suffix (Default: XAUUSD, auto-detects GOLD / XAUUSDm)
# GOLD_SYMBOL=XAUUSD

# Risk controls
MAX_POSITION_RISK_PERCENT=5.0
DEFAULT_SLIPPAGE=20
