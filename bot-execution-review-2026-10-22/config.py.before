"""
Configuration parameters for MT5 Automated Trading Agent.
Multi-Symbol Support: Gold (XAUUSD) & Bitcoin (BTCUSD) on 1-Minute Timeframe (M1TF).
"""

import os
from dataclasses import dataclass, field
from typing import List, Optional

@dataclass
class MT5Config:
    # MT5 Terminal Settings
    path: Optional[str] = None  # Auto-detect if None
    login: Optional[int] = None
    password: Optional[str] = None
    server: Optional[str] = None
    timeout: int = 60000

    # Multi-Symbol Support: XAUUSD (Gold) & BTCUSD (Bitcoin)
    symbols: List[str] = field(default_factory=lambda: ["XAUUSD", "BTCUSD"])
    timeframe_str: str = "M1"  # M1, M5, M15, M30, H1, H4, D1
    
    # Strategy & Trend Quality Filters
    strategy_name: str = "gold_3ma"  # gold_3ma, ema_rsi, breakout, ensemble
    ema_fast: int = 5
    ema_slow: int = 15
    rsi_period: int = 14
    atr_period: int = 14
    adx_period: int = 14
    adx_threshold: float = 22.0          # Institutional trend strength threshold (avoids chop)

    # Position Sizing Parameters (Anti-Martingale Smart Sizing)
    flat_lot_mode: bool = True           # Disables expanding inverted pyramiding to protect profits
    default_flat_lot: float = 0.01       # Consistent safe lot size per trade (0.01 lot)
    twin_trades_mode: bool = True        # Opens 2 trades simultaneously per signal
    trades_per_signal: int = 2           # Number of simultaneous trades per entry
    scaled_lot_enabled: bool = False
    base_lot: float = 0.10
    lot_step_increment: float = 0.05
    max_lot: float = 0.20

    # Risk Management & ATR Multipliers
    risk_percent_per_trade: float = 0.5
    sl_atr_multiplier: float = 1.6       # Calibrated for market structure breathing room
    tp_atr_multiplier: float = 2.0       # High probability institutional target
    max_spread_pips: float = 500.0  # Allow wider spread for BTCUSD ($5.00 spread tolerance)
    max_open_positions: int = 6     # Max 6 concurrent trades total across symbols
    max_positions_per_symbol: int = 3 # Max 3 concurrent trades per symbol

    # Grid / Staggered Entry Spacing
    min_entry_spacing_pips: float = 25.0

    # Wide-Breath Breakeven & Trailing Stop
    be_atr_threshold: float = 1.2        # Trigger breakeven after +1.2x ATR expansion
    be_lock_atr: float = 0.4             # Lock in guaranteed profit of +0.4x ATR
    trailing_stop_enabled: bool = True
    trailing_stop_atr_multiplier: float = 1.2

    # Circuit Breakers & Loss Caps
    # Circuit Breakers & Anti-Slippage Loss Caps
    hard_loss_trigger_usd: float = 8.0    # Trigger close at -$8.00 so slippage exits cleanly at -$9.50 to -$10.00
    max_loss_per_trade_usd: float = 10.0  # Absolute hard ceiling
    max_daily_drawdown_percent: float = 100.0

    # Profit Taking & Stabilization Rules (4 Upgraded Laws)
    single_tp_gold: float = 15.0                # Gold Take Profit (+15.00 USD)
    single_tp_btc: float = 10.0                 # Bitcoin Take Profit (+10.00 USD - calibrated for M1 volatility)
    single_trade_take_profit_usd: float = 15.0  # Fallback default
    basket_take_profit_usd: float = 100.0       # Immediate close of ALL trades when total open profit reaches +$100 USD
    post_loss_cooldown_seconds: int = 60        # 60s stabilization pause on symbol after a loss
    profit_lock_trigger_usd: float = 5.0        # Early Profit-Lock Trigger: Advance SL at +$5.00
    profit_lock_amount_usd: float = 1.0         # Guaranteed cash profit locked at +$1.00

    # Execution Mode
    mode: str = "live"
    magic_number: int = 20260911
    poll_interval_seconds: int = 5
    bars_count: int = 300

    @classmethod
    def from_env(cls) -> "MT5Config":
        symbols_raw = os.getenv("MT5_SYMBOLS", "XAUUSD,BTCUSD")
        return cls(
            path=os.getenv("MT5_PATH"),
            login=int(os.getenv("MT5_LOGIN")) if os.getenv("MT5_LOGIN") else None,
            password=os.getenv("MT5_PASSWORD"),
            server=os.getenv("MT5_SERVER"),
            symbols=[s.strip().upper() for s in symbols_raw.split(",") if s.strip()],
            timeframe_str=os.getenv("MT5_TIMEFRAME", "M1"),
            mode=os.getenv("MT5_MODE", "live"),
            strategy_name=os.getenv("MT5_STRATEGY", "gold_3ma"),
            max_open_positions=int(os.getenv("MT5_MAX_POSITIONS", "10")),
            max_positions_per_symbol=int(os.getenv("MT5_MAX_PER_SYMBOL", "5")),
        )
