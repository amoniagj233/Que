"""
Risk Manager Module
Enforces capital protection, Market Structure Swing SL/TP, Scaled Lot Sizing,
Staggered Entry Spacing, Spread Filters, Multi-Stage Breakeven, and Chandelier Trailing Stops.
"""

import logging
from typing import Dict, Any, List, Optional, Tuple
import pandas as pd
from config import MT5Config

logger = logging.getLogger("MT5Agent.RiskManager")

class RiskManager:
    def __init__(self, config: MT5Config):
        self.config = config
        self.initial_equity: Optional[float] = None

    def initialize_balance(self, current_equity: float):
        """Set starting equity for daily drawdown tracking."""
        if self.initial_equity is None:
            self.initial_equity = current_equity
            logger.info(f"Starting session equity set to: {current_equity:.2f}")

    def is_spread_allowed(self, symbol_info: Dict[str, Any]) -> bool:
        """Check if broker spread is within acceptable limits for Gold or Crypto."""
        symbol = symbol_info.get("symbol", "").upper()
        spread_pips = symbol_info.get("spread_pips", 0.0)

        max_allowed = 3000.0 if "BTC" in symbol or "CRYPTO" in symbol else self.config.max_spread_pips

        if spread_pips > max_allowed:
            logger.warning(f"[{symbol}] Spread too wide: {spread_pips:.2f} pips (Max: {max_allowed} pips)")
            return False
        return True

    def is_daily_drawdown_exceeded(self, current_equity: float) -> bool:
        """Circuit breaker check."""
        if self.config.max_daily_drawdown_percent >= 100.0 or self.initial_equity is None:
            return False

        drawdown_pct = ((self.initial_equity - current_equity) / self.initial_equity) * 100.0
        if drawdown_pct >= self.config.max_daily_drawdown_percent:
            logger.error(f"CIRCUIT BREAKER ACTIVATED: Equity drawdown is {drawdown_pct:.2f}%")
            return True
        return False

    def can_open_new_position(self, current_open_count: int, symbol_open_count: int) -> bool:
        """Check if position limits are exceeded."""
        if current_open_count >= self.config.max_open_positions:
            logger.warning(f"Max open positions reached ({current_open_count}/{self.config.max_open_positions}). Trade skipped.")
            return False
        if symbol_open_count >= self.config.max_positions_per_symbol:
            logger.warning(f"Max symbol open positions reached ({symbol_open_count}/{self.config.max_positions_per_symbol}). Trade skipped.")
            return False
        return True

    def is_spread_acceptable(self, symbol_info: Dict[str, Any]) -> bool:
        """Slippage & Spread Spike Shield: Rejects trade entry if spread is abnormally wide."""
        spread_raw = symbol_info.get("spread_raw", 0)
        symbol = symbol_info.get("symbol", "").upper()
        max_spread = 3500.0 if ("BTC" in symbol or "CRYPTO" in symbol) else 50.0
        if spread_raw > max_spread:
            logger.warning(f"Spread Spike Shield: [{symbol}] Current spread {spread_raw} exceeds max safe threshold {max_spread}. Entry aborted.")
            return False
        return True

    def is_staggered_entry_valid(self, symbol_open_positions: List[Dict[str, Any]], current_price: float, symbol_info: Dict[str, Any]) -> bool:
        """Ensure current price is spaced by min_entry_spacing_pips from existing positions."""
        if not symbol_open_positions:
            return True

        point = symbol_info.get("point", 0.01)
        digits = symbol_info.get("digits", 2)
        pip_scale = 10 if digits in (3, 5) else 1
        pip_size = point * pip_scale
        symbol = symbol_info.get("symbol", "").upper()

        if "BTC" in symbol or "CRYPTO" in symbol:
            min_dist_price = max(30.0, self.config.min_entry_spacing_pips * 2.0)
        else:
            min_dist_price = self.config.min_entry_spacing_pips * pip_size

        for pos in symbol_open_positions:
            price_open = pos["price_open"]
            dist = abs(current_price - price_open)
            if dist < min_dist_price:
                logger.info(f"Staggered spacing constraint: [{symbol}] Price ({current_price:.2f}) is only {dist:.2f} away from position #{pos['ticket']} ({price_open:.2f}). Required: {min_dist_price:.2f}.")
                return False

        return True

    def calculate_lot_size(self, account_info: Dict[str, Any], symbol_info: Dict[str, Any], sl_distance_pips: float) -> float:
        """Calculate position lot size dynamically based on % Account Risk."""
        equity = account_info.get("equity", 0.0)
        if equity <= 0:
            return self.config.base_lot

        risk_amount = equity * (self.config.risk_percent_per_trade / 100.0)
        contract_size = symbol_info.get("trade_contract_size", 100)
        point = symbol_info.get("point", 0.01)
        digits = symbol_info.get("digits", 2)

        pip_scale = 10 if digits in (3, 5) else 1
        pip_size = point * pip_scale
        pip_value = contract_size * pip_size

        if sl_distance_pips <= 0 or pip_value <= 0:
            return self.config.base_lot

        calculated_lot = risk_amount / (sl_distance_pips * pip_value)

        vol_min = symbol_info.get("volume_min", 0.01)
        vol_max = symbol_info.get("volume_max", 100.0)
        vol_step = symbol_info.get("volume_step", 0.01)

        steps = round(calculated_lot / vol_step)
        final_lot = max(vol_min, min(vol_max, min(self.config.max_lot, steps * vol_step)))
        return round(final_lot, 2)

    def calculate_scaled_lot_size(self, symbol_open_count: int, symbol_info: Dict[str, Any]) -> float:
        """Position Sizing: Anti-Martingale Smart Sizing to prevent inverted pyramiding risk."""
        vol_min = symbol_info.get("volume_min", 0.01)
        vol_max = symbol_info.get("volume_max", 100.0)
        vol_step = symbol_info.get("volume_step", 0.01)

        # Flat lot mode enforces consistent risk per trade (no large tail-end losses)
        if getattr(self.config, 'flat_lot_mode', True):
            lot = getattr(self.config, 'default_flat_lot', 0.10)
            steps = round(lot / vol_step)
            final_lot = max(vol_min, min(vol_max, min(self.config.max_lot, steps * vol_step)))
            logger.info(f"Smart Sizing (Flat Mode): Trade #{symbol_open_count + 1} -> Lot Size = {round(final_lot, 2)}")
            return round(final_lot, 2)

        if not self.config.scaled_lot_enabled:
            return self.config.base_lot

        calculated_lot = self.config.base_lot + (symbol_open_count * self.config.lot_step_increment)

        steps = round(calculated_lot / vol_step)
        final_lot = max(vol_min, min(vol_max, min(self.config.max_lot, steps * vol_step)))
        final_lot = round(final_lot, 2)

        logger.info(f"Scaled Lot Sizing: Open Trade #{symbol_open_count + 1} -> Lot Size = {final_lot}")
        return final_lot

    def calculate_sl_tp(self, action: str, price: float, atr: float, symbol_info: Dict[str, Any], df: Optional[pd.DataFrame] = None) -> Tuple[float, float, float]:
        """
        Improved Stop Loss Calculation:
        Combines Market Structure Swing Low/High support with ATR buffer to prevent premature stop-outs.
        Enforces broker-compliant minimum stop distances for both Forex/Gold and Crypto (BTCUSD).
        """
        point = symbol_info.get("point", 0.01)
        digits = symbol_info.get("digits", 2)
        pip_scale = 10 if digits in (3, 5) else 1
        pip_size = point * pip_scale
        symbol = symbol_info.get("symbol", "").upper()

        stops_level_pts = symbol_info.get("trade_stops_level", 0)
        spread_pts = symbol_info.get("spread", 0)

        # Minimum distance required by broker constraints
        if "BTC" in symbol or "CRYPTO" in symbol:
            min_sl_dist = max(35.0, (stops_level_pts + spread_pts + 500) * point)
            min_tp_dist = max(50.0, (stops_level_pts + 500) * point)
        else:
            min_sl_dist = max(0.30, (stops_level_pts + spread_pts + 20) * point)
            min_tp_dist = max(0.50, (stops_level_pts + 20) * point)

        # Default ATR distances
        atr_sl_dist = max(atr * self.config.sl_atr_multiplier, min_sl_dist)
        atr_tp_dist = max(atr * self.config.tp_atr_multiplier, min_tp_dist)

        if df is not None and len(df) >= 15:
            # Extract Market Structure Swing Low (15 bars) for BUY or Swing High for SELL
            recent_low = df['low'].iloc[-15:].min()
            recent_high = df['high'].iloc[-15:].max()
            buffer = max(atr * 0.3, 10.0 if "BTC" in symbol else 5.0 * point)

            if action.upper() == "BUY":
                struct_sl = recent_low - buffer
                sl_price = min(price - atr_sl_dist, struct_sl)
                if (price - sl_price) < min_sl_dist:
                    sl_price = price - min_sl_dist
                tp_price = price + max(atr_tp_dist, (price - sl_price) * 1.8)
                if (tp_price - price) < min_tp_dist:
                    tp_price = price + min_tp_dist
            else:
                struct_sl = recent_high + buffer
                sl_price = max(price + atr_sl_dist, struct_sl)
                if (sl_price - price) < min_sl_dist:
                    sl_price = price + min_sl_dist
                tp_price = price - max(atr_tp_dist, (sl_price - price) * 1.8)
                if (price - tp_price) < min_tp_dist:
                    tp_price = price - min_tp_dist
        else:
            if action.upper() == "BUY":
                sl_price = price - atr_sl_dist
                tp_price = price + atr_tp_dist
            else:
                sl_price = price + atr_sl_dist
                tp_price = price - atr_tp_dist

        sl_distance_pips = abs(price - sl_price) / pip_size
        logger.info(f"Market Structure SL: {action} @ {price:.2f} | SL: {sl_price:.2f} (Dist: {sl_distance_pips:.1f} pips) | TP: {tp_price:.2f}")

        return round(sl_price, digits), round(tp_price, digits), sl_distance_pips

    def calculate_trailing_stop(self, pos: Dict[str, Any], symbol_info: Dict[str, Any], current_atr: float, df: Optional[pd.DataFrame] = None) -> Optional[float]:
        """
        Chandelier Volatility Trailing Stop:
        Trails highest high over last 15 bars - (1.2 * ATR) for BUYs,
        and lowest low over last 15 bars + (1.2 * ATR) for SELLs.
        Enforces broker stop distance from current market price.
        """
        action = pos["type"]
        price_open = pos["price_open"]
        price_curr = pos["price_current"]
        current_sl = pos["sl"]
        digits = symbol_info["digits"]
        point = symbol_info.get("point", 0.01)
        symbol = symbol_info.get("symbol", "").upper()

        stops_level_pts = symbol_info.get("trade_stops_level", 0)
        spread_pts = symbol_info.get("spread", 0)

        if "BTC" in symbol or "CRYPTO" in symbol:
            min_sl_dist = max(35.0, (stops_level_pts + spread_pts + 500) * point)
        else:
            min_sl_dist = max(0.30, (stops_level_pts + spread_pts + 20) * point)

        trail_distance = max(current_atr * self.config.trailing_stop_atr_multiplier, min_sl_dist)

        if df is not None and len(df) >= 15:
            recent_high = df['high'].iloc[-15:].max()
            recent_low = df['low'].iloc[-15:].min()
            
            if action == "BUY":
                chandelier_sl = recent_high - trail_distance
                new_sl = max(price_curr - trail_distance, chandelier_sl)
                # Must stay below current market price by min_sl_dist to avoid Invalid Stops
                if new_sl <= (price_curr - min_sl_dist) and new_sl > price_open and (current_sl == 0.0 or new_sl > current_sl + (symbol_info["point"] * 10)):
                    return round(new_sl, digits)
            elif action == "SELL":
                chandelier_sl = recent_low + trail_distance
                new_sl = min(price_curr + trail_distance, chandelier_sl)
                # Must stay above current market price by min_sl_dist to avoid Invalid Stops
                if new_sl >= (price_curr + min_sl_dist) and new_sl < price_open and (current_sl == 0.0 or new_sl < current_sl - (symbol_info["point"] * 10)):
                    return round(new_sl, digits)
        else:
            if action == "BUY":
                new_sl = price_curr - trail_distance
                if new_sl <= (price_curr - min_sl_dist) and new_sl > price_open and (current_sl == 0.0 or new_sl > current_sl + (symbol_info["point"] * 10)):
                    return round(new_sl, digits)
            elif action == "SELL":
                new_sl = price_curr + trail_distance
                if new_sl >= (price_curr + min_sl_dist) and new_sl < price_open and (current_sl == 0.0 or new_sl < current_sl - (symbol_info["point"] * 10)):
                    return round(new_sl, digits)

        return None
